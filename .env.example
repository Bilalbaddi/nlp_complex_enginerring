# ---- Copy to .env (`python scripts/tasks.py setup` does this and generates JWT_SECRET) ----
ENV=development
LOG_LEVEL=INFO

# ============ SUPABASE: the ONLY external service (Postgres + Storage) ============
# Enable nothing by hand: the first Alembic migration runs CREATE EXTENSION IF NOT EXISTS postgis / vector,
# and the backend creates the private Storage buckets itself.
#
# DATABASE_URL: Supabase dashboard > Connect > Transaction pooler (port 6543). This is what the app uses.
# URL-encode special characters in the password (@ -> %40, # -> %23). sslmode=require is added automatically.
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:6543/postgres
# MIGRATION_DATABASE_URL: SESSION pooler, same host but port 5432. Used by Alembic and the tests (they need
# session-level state, which the transaction pooler does not keep). The direct db.<ref>.supabase.co host is
# IPv6-only on the free tier and often unreachable. If left empty, DATABASE_URL is used.
MIGRATION_DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:5432/postgres
# Keep small: the free tier allows few concurrent connections.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5

# Storage + API: dashboard > Project Settings > API
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# The secret service_role key. BACKEND ONLY: never put it in the frontend or commit it.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
# Private buckets (created automatically)
STORAGE_BUCKET_UPLOADS=sgdss-uploads
STORAGE_BUCKET_DOCUMENTS=sgdss-documents
STORAGE_BUCKET_REPORTS=sgdss-reports

# ---- Background jobs (Postgres `jobs` table) ----
# true = jobs run immediately inside the API process (no worker needed). Default: true in development.
# Set false and run `python scripts/tasks.py worker` to process jobs in a separate process.
JOBS_INLINE=true

# ---- Auth: generated by `tasks.py setup`, or run: python -c "import secrets; print(secrets.token_urlsafe(48))" ----
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ORIGINS=http://localhost:3000

# Rate limits (requests per minute, counted in Postgres)
RATE_LIMIT_ENABLED=true
LOGIN_RATE_LIMIT_PER_MINUTE=10
LLM_RATE_LIMIT_PER_MINUTE=20

# ---- LLM (Groq) ----
# LLM_PROVIDER=groq uses the Groq API; mock (or an empty key) runs the app in demo mode with template text.
LLM_PROVIDER=mock
# Create a key at https://console.groq.com > API Keys. BACKEND ONLY: never expose it to the frontend.
GROQ_API_KEY=
# Pick CURRENT model names from the Groq console (https://console.groq.com/docs/models); models change over time,
# so none are hardcoded. Tested with: LLM_MODEL=openai/gpt-oss-120b (assistant, briefs), LLM_FAST_MODEL=openai/gpt-oss-20b
# (summaries, zero-shot classification). The free tier allows roughly 8,000 tokens per minute per model.
LLM_MODEL=
LLM_FAST_MODEL=
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1024
LLM_TIMEOUT_S=60
LLM_MAX_RETRIES=4
# gpt-oss models only: low | medium | high (less reasoning = faster and cheaper)
LLM_REASONING_EFFORT=low
# How long identical prompts are served from the cache (seconds)
LLM_CACHE_TTL_SECONDS=86400

# ---- Embeddings: Hugging Face Inference API (nothing is downloaded locally) ----
# Create a token at https://huggingface.co/settings/tokens (fine-grained: "Make calls to Inference Providers").
HUGGINGFACEHUB_API_TOKEN=
# auto = use HF when the token is set, otherwise an offline hashing embedder (lower quality, used only for demos/tests)
EMBEDDING_PROVIDER=auto
# Must output EMBEDDING_DIM dimensions (384 matches the pgvector column). Verified working model:
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIM=384
HF_BATCH_SIZE=64
HF_CONCURRENCY=4
HF_REQUESTS_PER_MINUTE=120
# Trained model artifacts are cached here (git-ignored) and stored in the private Supabase bucket below.
MODEL_CACHE_DIR=.cache/models
STORAGE_BUCKET_MODELS=sgdss-models
# Complaints below this classifier confidence (or confidently disagreeing with their label) go to human review
REVIEW_CONFIDENCE_THRESHOLD=0.6

# ---- Synthetic data size (Phase 2) ----
# Supabase free tier = 500 MB including indexes. Measured: 25,000 complaints (+feedback, performance, indexes) = ~44 MB;
# 50,000 is ~75 MB incl. embeddings (Phase 3). Check real usage any time with: python scripts/tasks.py db-size
# Check real usage any time with: python scripts/tasks.py db-size
SEED_COMPLAINT_COUNT=50000
SEED_YEARS=3
SEED_RANDOM_SEED=42

# ---- Ports ----
BACKEND_PORT=8000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Demo accounts created by `tasks.py seed-users`
DEMO_PASSWORD=Demo@12345
